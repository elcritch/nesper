#strict
#importc
#cdecl
#header

#reordercomments
#mergeDuplicates
#skipFuncDefines
#importFuncDefines

#mergeblocks
#stdints
#cppSkipCallOp
#cppSkipConverter
#cppskipconverter

#render nonNep1Imports
#render extranewlines
#render reindentlongcomments

#mangle "'va_list'" "varargs[pointer]"
#mangle "'_Bool'" "bool"

#delete "RCUTILS_ERROR_STATE_FILE_MAX_LENGTH"
#delete "'rcutils/stdatomic_helper'"
